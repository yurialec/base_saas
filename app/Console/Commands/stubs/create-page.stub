<template>
    <section class="page">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
            <h1 class="h4 mb-0">Cadastrar {{ label }}</h1>
            <router-link class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2"
                :to="{ name: '{{ route }}' }">
                <i class="bi bi-arrow-left"></i>
                <span>Voltar</span>
            </router-link>
        </div>

        <form class="row g-4 justify-content-center" @submit.prevent="store">
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pb-0">
                        <h2 class="h6 mb-0">Dados de {{ label }}</h2>
                    </div>
                    <div class="card-body bg-white">
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Nome</label>
                                <input v-model="{{ variable }}.name" class="form-control" type="text" required>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button class="btn btn-primary btn-sm text-white" type="submit" :disabled="isLoading">
                                <span v-if="isLoading" class="spinner-border spinner-border-sm" role="status"></span>
                                <span v-else>Salvar</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </section>
</template>

<script>
export default {
    name: 'Create{{ class }}',
    data() {
        return {
            isLoading: false,
            {{ variable }}: {
                name: ''
            }
        };
    },
    methods: {
        store() {
            this.isLoading = true;

            axios.post('/api/{{ route }}/store', this.{{ variable }})
                .then(response => {
                    this.$router.push({ name: '{{ route }}' });
                })
                .catch(error => {
                    alertDanger(error);
                })
                .finally(() => {
                    this.isLoading = false;
                });
        }
    }
};
</script>

<style scoped>
.page .card {
    border-radius: 0.5rem;
}
</style>
